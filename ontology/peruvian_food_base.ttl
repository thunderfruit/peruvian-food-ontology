@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pf: <http://unitru.edu.pe/ai2/peruvian-food#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://unitru.edu.pe/ai2/peruvian-food> a owl:Ontology ;
    rdfs:label "Ontología gastronómica peruana (Trujillo, 2026)"@es .

pf:ciudad a owl:DatatypeProperty ;
    rdfs:label "ciudad"@es ;
    rdfs:domain pf:Plato ;
    rdfs:range xsd:string .

pf:contieneAlergeno a owl:ObjectProperty ;
    rdfs:label "contiene alérgeno"@es ;
    rdfs:range pf:Alergeno .

pf:esTecnicaSaludable a owl:DatatypeProperty ;
    rdfs:label "es técnica saludable"@es ;
    rdfs:domain pf:TecnicaDeCoccion ;
    rdfs:range xsd:boolean .

pf:fuente a owl:DatatypeProperty ;
    rdfs:label "fuente"@es ;
    rdfs:domain pf:Plato ;
    rdfs:range xsd:string .

pf:ingrediente_aceite_de_ajonjoli a pf:InsumoGeneral,
        owl:NamedIndividual ;
    rdfs:label "Aceite de ajonjolí"@es ;
    pf:contieneAlergeno pf:alergeno_sesamo ;
    pf:tipoDeAlimento "grasa" .

pf:ingrediente_aguacate a pf:Ingrediente,
        owl:NamedIndividual ;
    rdfs:label "aguacate"@es ;
    pf:sinonimoDe pf:ingrediente_palta .

