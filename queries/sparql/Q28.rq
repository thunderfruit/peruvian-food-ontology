PREFIX pf: <https://thunderfruit.github.io/peruvian-food-ontology/ontology#>
SELECT DISTINCT ?plato WHERE {
  ?plato a pf:Plato .
  ?plato pf:ciudad "Trujillo" .
  ?plato a pf:PlatoAptoParaMantenimientoDePeso .
  FILTER NOT EXISTS { ?plato pf:contieneAlergeno ?a . VALUES ?a { pf:alergeno_mani pf:alergeno_frutos_secos } }
}
